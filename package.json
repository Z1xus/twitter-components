{
  "name": "twitter-components",
  "version": "0.2.0",
  "description": "Composable Twitter web components with typed data, slots, and server rendering.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://z1xus.github.io/twitter-components/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z1xus/twitter-components.git"
  },
  "bugs": {
    "url": "https://github.com/z1xus/twitter-components/issues"
  },
  "author": {
    "name": "z1xus",
    "email": "hi@z1x.us",
    "url": "https://z1x.us"
  },
  "files": [
    "assets/preview.png",
    "dist",
    "custom-elements.json",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.build.json && tsx scripts/generate-docs.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src scripts/*.ts docs README.md package.json",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:dev": "tsx scripts/generate-docs.ts && cd docs && astro dev --host 127.0.0.1",
    "docs:build": "tsx scripts/generate-docs.ts && cd docs && astro build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.2",
    "@astrojs/markdown-remark": "^7.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "starlight-typedoc": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~6.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "@types/node": "^26.5.1"
  },
  "keywords": [
    "twitter",
    "web-components",
    "custom-elements",
    "typescript",
    "ssr",
    "svelte",
    "react",
    "vue"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
